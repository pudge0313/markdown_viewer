{
  "name": "markdown-viewer",
  "productName": "Markdown 查看器",
  "version": "1.2.0",
  "description": "本地只读 Markdown 查看器（标签页 / 大纲 / 查找 / 公式 / 图表 / 导出）",
  "main": "src/main.js",
  "author": "pudge0313",
  "license": "MIT",
  "scripts": {
    "vendor": "node tools/vendor.js",
    "prestart": "node tools/vendor.js",
    "start": "electron .",
    "shot": "node tools/vendor.js && electron tools/shot.js",
    "test": "node tools/smoke.js",
    "lint": "node tools/lint.js",
    "predist": "node tools/vendor.js",
    "dist": "electron-builder --win",
    "e2e": "node tools/e2e.js",
    "check": "node tools/lint.js && node tools/smoke.js",
    "verify:dist": "node tools/packaged-check.js"
  },
  "devDependencies": {
    "dompurify": "^3.4.17",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "mermaid": "^12.3.0"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "katex": "^0.19.1",
    "marked": "^14.1.0"
  },
  "build": {
    "appId": "com.pudge0313.markdownviewer",
    "productName": "Markdown 查看器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Markdown 查看器",
      "artifactName": "MarkdownViewer-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown 文档",
        "description": "Markdown 文档",
        "role": "Viewer"
      },
      {
        "ext": "markdown",
        "name": "Markdown 文档",
        "description": "Markdown 文档",
        "role": "Viewer"
      },
      {
        "ext": "mdx",
        "name": "MDX 文档",
        "description": "MDX 文档",
        "role": "Viewer"
      }
    ],
    "portable": {
      "artifactName": "MarkdownViewer-Portable-${version}.${ext}"
    }
  }
}
